FROM his-poc-server:ai-6bed11a513f0-perm1
USER root
RUN ["python", "-c", "\nimport hashlib,json\nfrom pathlib import Path\nroot=Path('/app')\nassert root.is_dir() and not root.is_symlink() and root.resolve(strict=True)==root\npaths=[root,*root.rglob('*')]\nassert all(not path.is_symlink() and path.resolve(strict=True).is_relative_to(root) and (path.is_dir() or path.is_file()) for path in paths)\ndef fingerprint():\n return {p.relative_to(root).as_posix():{'mode':p.stat().st_mode&0o777,'uid':p.stat().st_uid,'gid':p.stat().st_gid,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in paths if p.is_file()}\nbefore=fingerprint()\ndirectories={p.relative_to(root).as_posix():p.stat().st_mode&0o777 for p in paths if p.is_dir()}\nfor path in paths:\n if path.is_dir():path.chmod(0o755)\nassert fingerprint()==before,'A file mode, owner or content changed'\nassert all(path.stat().st_mode&0o777==0o755 for path in paths if path.is_dir())\nassert all(not path.is_symlink() and path.resolve(strict=True).is_relative_to(root) for path in paths)\nprint(json.dumps({'directory_metadata_only':True,'directories':len(directories),'changed_directories':sum(mode!=0o755 for mode in directories.values()),'files_unchanged':len(before),'file_fingerprint_sha256':hashlib.sha256(json.dumps(before,sort_keys=True,separators=(',',':')).encode()).hexdigest()}))\n"]
USER his
