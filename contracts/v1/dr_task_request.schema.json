{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:his-poc:contracts:v1:dr_task_request",
  "title": "dr_task_request",
  "x-implementation-status": "DESIGN_ONLY_SPECIALIST_NOT_CONNECTED",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "patient_id": {
          "type": "string",
          "minLength": 1
        },
        "encounter_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose_of_use": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "user_id",
        "patient_id",
        "encounter_id",
        "purpose_of_use"
      ],
      "additionalProperties": false
    },
    "data_class": {
      "enum": [
        "synthetic",
        "deidentified",
        "restricted"
      ]
    },
    "deadline_utc": {
      "type": "string",
      "format": "date-time"
    },
    "model_registry_alias": {
      "type": "string",
      "minLength": 1
    },
    "expected_model_revision": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "const": "dr_retinal_grading"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "artifact": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "source_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "artifact_id",
              "sha256",
              "media_type",
              "source_version"
            ],
            "additionalProperties": false
          },
          "eye": {
            "enum": [
              "left",
              "right"
            ]
          },
          "modality": {
            "const": "color_fundus_photography"
          },
          "capture_protocol_version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "artifact",
          "eye",
          "modality",
          "capture_protocol_version"
        ],
        "additionalProperties": false
      }
    },
    "preprocessing_version": {
      "type": "string",
      "minLength": 1
    },
    "mask_policy": {
      "enum": [
        "none",
        "versioned_mask"
      ]
    },
    "mask_artifact": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            },
            "source_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "artifact_id",
            "sha256",
            "media_type",
            "source_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluator_protocol": {
      "const": "DR_PROTOCOL_V1"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "context",
    "data_class",
    "deadline_utc",
    "model_registry_alias",
    "expected_model_revision",
    "task_type",
    "images",
    "preprocessing_version",
    "mask_policy",
    "mask_artifact",
    "evaluator_protocol"
  ],
  "additionalProperties": false
}
