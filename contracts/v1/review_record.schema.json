{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:his-poc:contracts:v1:review_record",
  "title": "review_record",
  "x-implementation-status": "IMPLEMENTED_API_SHAPE",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "proposal": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "action_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "edit"
      ]
    },
    "edits": {
      "type": "string",
      "description": "JSON string containing edit text or null"
    },
    "created": {
      "type": "number"
    }
  },
  "required": [
    "id",
    "proposal",
    "version",
    "action_hash",
    "reviewer",
    "decision",
    "edits",
    "created"
  ],
  "additionalProperties": false
}
