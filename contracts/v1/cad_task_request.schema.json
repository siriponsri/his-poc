{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:his-poc:contracts:v1:cad_task_request",
  "title": "cad_task_request",
  "x-implementation-status": "DESIGN_ONLY_SPECIALIST_NOT_CONNECTED",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "patient_id": {
          "type": "string",
          "minLength": 1
        },
        "encounter_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose_of_use": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tenant_id",
        "user_id",
        "patient_id",
        "encounter_id",
        "purpose_of_use"
      ],
      "additionalProperties": false
    },
    "data_class": {
      "enum": [
        "synthetic",
        "deidentified",
        "restricted"
      ]
    },
    "deadline_utc": {
      "type": "string",
      "format": "date-time"
    },
    "model_registry_alias": {
      "type": "string",
      "minLength": 1
    },
    "expected_model_revision": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "const": "cad_risk"
    },
    "population_definition_version": {
      "type": "string",
      "minLength": 1
    },
    "prediction_horizon": {
      "type": "string",
      "minLength": 1
    },
    "feature_schema_revision": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "measured_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "object",
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "source_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "artifact_id",
              "sha256",
              "media_type",
              "source_version"
            ],
            "additionalProperties": false
          },
          "missing_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "measured_at",
          "source",
          "missing_reason"
        ],
        "additionalProperties": false
      }
    },
    "preprocessing_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_protocol": {
      "const": "CAD_PROTOCOL_V1"
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "context",
    "data_class",
    "deadline_utc",
    "model_registry_alias",
    "expected_model_revision",
    "task_type",
    "population_definition_version",
    "prediction_horizon",
    "feature_schema_revision",
    "features",
    "preprocessing_version",
    "evaluator_protocol"
  ],
  "additionalProperties": false
}
