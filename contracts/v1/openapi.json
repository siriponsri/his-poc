    "/api/v1/proposals": {
      "post": {
        "operationId": "proposals",
        "security": [
          {
            "DemoBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "propose_request.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed attempt. Inspect outcome: success has proposal; failed, timeout or abstained has error/reason and no proposal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "propose_response.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, content type, request shape or body size. No workflow side effects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Demo authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "User, tenant, patient or encounter scope denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Version, state, expiry, context or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Requested proposal or route not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.schema.json"
                }
              }
            }
          },
          "500": {
            "description": "Sanitized internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "error.schema.json"
                }
              }
            }
          }
        }
      }
