{
  "name": "his-poc-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sync-data": "python scripts/sync_data.py",
    "typecheck": "tsc --noEmit",
    "build": "python scripts/sync_full_catalog.py && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:component": "node --import tsx --test tests/*.component.test.tsx",
    "test:audit": "node scripts/audit_regression.mjs ../..",
    "sync-full-catalog": "python scripts/sync_full_catalog.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/ibm-plex-sans-thai-looped": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
