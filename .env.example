# Copying this file is insufficient: scripts/dev.py init creates random local secrets.
# Never commit/share .env. No inference credentials are needed for the explicit mock.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_DEV_INIT
HIS_SEED_PASSWORD=CHANGE_ME_GENERATE_WITH_DEV_INIT
HIS_WEB_PORT=8000
# Native PostgreSQL only; credentials below are examples, not runnable accounts.
DATABASE_URL=postgresql+psycopg://his_owner:CHANGE_ME@127.0.0.1:5432/his_poc
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_ROOT=./var/files
BACKUP_ROOT=./var/backups
WEB_DIST=./apps/web/dist
HIS_ENV=development
HIS_COOKIE_SECURE=false
HIS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
HIS_AI_PROVIDER=mock_demo
# Optional real inference: the named Typhoon/Ollama route has synthetic document evidence.
# Default remains mock; opt in only to the authorized private route.
# Exact identity and limitations: config/model_registry.json and evidence/fullsystem/live-ai/.
HIS_LIVE_SYNTHETIC_ENABLED=false
DR_TRAIN_BASE_URL=
DR_TRAIN_MODEL=
DR_TRAIN_MODEL_DIGEST=
DR_TRAIN_OLLAMA_VERSION=
DR_TRAIN_TIMEOUT_SECONDS=180
DR_TRAIN_MAX_OUTPUT_TOKENS=1024
DR_TRAIN_CONTEXT_TOKENS=8192
DR_TRAIN_MAX_DOCUMENT_CHARS=6000
DR_TRAIN_KEEP_ALIVE_SECONDS=0
# Optional owner-machine SSH forwarding; no private key is copied into the app.
# Set the existing SSH target in private .env; scripts/dr_train_tunnel.py verifies model identity.
DR_TRAIN_TUNNEL_ENABLED=false
DR_TRAIN_SSH_TARGET=dr-train
# Explicit global DB/files backup authority, not grantable via application role UI.
HIS_PLATFORM_OPERATORS=user-operations_admin
# Existing dr-train Ollama0.12.6/Typhoon manifest and GPU inventory were observed.
# Addresses stay private. HF revision, physical weight hash, server cancellation and clinical quality remain UNKNOWN/NOT_RUN.
# MedGemma27B was listed as installed but was not invoked. Other live providers remain disabled.

# Optional new staff preparation workspace. Disabled until separately qualified.
# Docs: docs/AI_DRIVEN_CONTRACT_V1.md and docs/AI_PROFILE_QUALIFICATION_PLAN.md.
# These are distinct from the existing document-completeness settings above.
HIS_ASSISTANT_ENABLED=false
HIS_ASSISTANT_LIVE_SYNTHETIC_ENABLED=false
HIS_ASSISTANT_BASE_URL=
HIS_ASSISTANT_MODEL=
HIS_ASSISTANT_MODEL_DIGEST=
HIS_ASSISTANT_OLLAMA_VERSION=
HIS_ASSISTANT_TEMPLATE_SHA256=
HIS_ASSISTANT_CONTEXT_TOKENS=4096
HIS_ASSISTANT_MAX_OUTPUT_TOKENS=512
HIS_ASSISTANT_TIMEOUT_SECONDS=90
# Empty means no profile is qualified. Never fill this from role availability.
HIS_ASSISTANT_QUALIFIED_PROFILES=
