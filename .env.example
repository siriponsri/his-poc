# Copying this file is insufficient: scripts/dev.py init creates random local secrets.
# Never commit/share .env. No inference credentials are needed for the explicit mock.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_DEV_INIT
HIS_SEED_PASSWORD=CHANGE_ME_GENERATE_WITH_DEV_INIT
HIS_WEB_PORT=8000
# Native PostgreSQL only; credentials below are examples, not runnable accounts.
DATABASE_URL=postgresql+psycopg://his_owner:CHANGE_ME@127.0.0.1:5432/his_poc
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_ROOT=./var/files
BACKUP_ROOT=./var/backups
WEB_DIST=./apps/web/dist
HIS_ENV=development
HIS_COOKIE_SECURE=false
HIS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
HIS_AI_PROVIDER=mock_demo
# Explicit global DB/files backup authority, not grantable via application role UI.
HIS_PLATFORM_OPERATORS=user-operations_admin
# Live inference endpoint, hardware, model/checkpoint revision: UNKNOWN. Disabled.
